# Prefer `make init`: generates .env with random credentials, mode 0600.
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
CRAWLOPS_ADMIN_EMAIL=admin@crawlops.local
CRAWLOPS_ADMIN_PASSWORD=replace-with-a-long-random-password
CRAWLOPS_AGENT_TOKEN=replace-with-random-agent-token
CRAWLOPS_ENCRYPTION_KEY=generate-with-make-init
CRAWLOPS_PORT=8080
